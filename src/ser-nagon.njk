---
pagination:
  data: langs
  size: 1
  alias: lang
permalink: "{{ '/ser-nagon/' | langPath(lang) }}"
layout: layout.njk
eleventyComputed:
  title: "{{ 'nav.ser' | t(lang) }}"
---
<nav class="crumb" aria-label="{{ 'site.tillbaka' | t(lang) }}"><a href="{{ '/' | langPath(lang) }}">← {{ 'nav.hem' | t(lang) }}</a></nav>
<h1>{{ 'ser.rubrik' | t(lang) }}</h1>
<p>{{ 'ser.intro' | t(lang) }}</p>

<section class="steg steg-nod" aria-labelledby="steg1">
  <h2 id="steg1">{{ 'ser.steg1.fraga' | t(lang) }}</h2>
  <p>{{ 'ser.steg1.hjalp' | t(lang) }}</p>
  <p class="svar ja"><strong>{{ 'ser.steg1.ja' | t(lang) }}</strong></p>
  <p class="nod-nummer"><span class="tel stor">112</span> <a class="lank" href="tel:112">{{ 'plats.ring' | t(lang) }}</a></p>
  <p class="svar nej">{{ 'ser.steg1.nej' | t(lang) }}</p>
</section>

<section class="steg" aria-labelledby="steg2">
  <h2 id="steg2">{{ 'ser.steg2.fraga' | t(lang) }}</h2>
  <p class="svar ja"><strong>{{ 'ser.steg2.ja' | t(lang) }}</strong></p>
  <ul class="kontakter">
  {% set utanId = true %}
  {% for id in ['socialjouren', 'uppsokarteamet', 'uppsokande-eu-team'] %}
    {% set kontakt = data.kontaktById[id] %}
    {% if kontakt %}{% include "kontakt.njk" %}{% endif %}
  {% endfor %}
  </ul>
  <p class="svar nej">{{ 'ser.steg2.nej' | t(lang) }}</p>
</section>

<section class="steg" aria-labelledby="steg3">
  <h2 id="steg3">{{ 'ser.steg3.fraga' | t(lang) }}</h2>
  <p>{{ 'ser.steg3.text' | t(lang) }}</p>
  <h3>{{ 'ser.tips.rubrik' | t(lang) }}</h3>
  <ul class="tips">
  {% for tip in 'ser.tips.lista' | t(lang) %}<li>{{ tip }}</li>{% endfor %}
  <li><a href="{{ '/guide/' | langPath(lang) }}">{{ 'nav.guide' | t(lang) }} →</a></li>
  </ul>
</section>

{% set utanId = false %}
<section aria-labelledby="nummer">
  <h2 id="nummer">{{ 'ser.nummer' | t(lang) }}</h2>
  <ul class="kontakter">
  {% for kontakt in data.kontakter %}{% include "kontakt.njk" %}{% endfor %}
  </ul>
</section>
