{# Förväntar sig: kontakt, lang #}
<li class="kontakt"{% if not utanId %} id="{{ kontakt.id }}"{% endif %}>
  <span class="kontakt-namn">{{ kontakt.namn }}</span>
  {% if kontakt.telefon %}<span class="tel stor">{{ kontakt.telefon }}</span> <a class="lank" href="{{ kontakt.telefon | telHref }}">{{ 'plats.ring' | t(lang) }}</a>{% endif %}
  {% set b = kontakt.beskrivning[lang] or kontakt.beskrivning.sv %}
  {% if b %}<span class="kontakt-text">{{ b }}</span>{% endif %}
  {% set o = kontakt.oppet[lang] or kontakt.oppet.sv %}
  {% if o %}<span class="kontakt-text">{{ 'ser.oppet' | t(lang) }}: {{ o }}</span>{% endif %}
  <span class="kontroll">{% if kontakt.status != 'verifierad' %}<span class="badge ej">{{ 'plats.ejVerifierad' | t(lang) }}</span> {% endif %}{% if kontakt.webb %}<a href="{{ kontakt.webb }}" rel="noopener">{{ 'plats.webb' | t(lang) }} ↗</a> · {% endif %}<a href="{{ kontakt.kalla }}" rel="noopener">{{ 'plats.kalla' | t(lang) }} ↗</a></span>
</li>
